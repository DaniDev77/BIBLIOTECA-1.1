unit uTelaHeranca;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Data.DB, Vcl.StdCtrls, Vcl.Buttons, Vcl.Grids, Vcl.DBGrids, Vcl.ExtCtrls,
  Vcl.ComCtrls, FireDAC.Stan.Intf, FireDAC.Stan.Option, FireDAC.Stan.Param, FireDAC.Stan.Error, FireDAC.DatS,
  FireDAC.Phys.Intf, FireDAC.DApt.Intf, FireDAC.Stan.Async, FireDAC.DApt, FireDAC.Comp.DataSet, FireDAC.Comp.Client;

type
  THeranca = class(TForm)
    pgcPrincipal: TPageControl;
    TabListagem: TTabSheet;
    TabManutencao: TTabSheet;
    Listagem: TPanel;
    grdListagem: TDBGrid;
    Rodape: TPanel;
    btnNovo: TBitBtn;
    btnAlterar: TBitBtn;
    btnCancelar: TBitBtn;
    btnGravar: TBitBtn;
    btnApagar: TBitBtn;
    btnFechar: TBitBtn;
    FDQListagem: TFDQuery;
    dtslistagem: TDataSource;

  private
    procedure ControlarBotoes(btnNovo, btnAlterar, btnCancelar, btnGravar, btnApagar: TBitBtn; pgcPrincipal: TPageControl;
      Flag: Boolean);
    { Private declarations }
  public
    { Public declarations }
  end;

var
  Heranca: THeranca;

implementation

{$R *.dfm}


{$REGION ' PROCEDIMENTO DE CONTROLE DE TELA'}
procedure THeranca.ControlarBotoes(btnNovo, btnAlterar, btnCancelar ,
 btnGravar, btnApagar:TBitBtn ;
  pgcPrincipal: TPageControl ; Flag:Boolean);
begin
    btnNovo.Enabled  :=Flag;
    btnApagar.Enabled   :=Flag;
    btnAlterar.Enabled  :=Flag;
    pgcPrincipal.Pages[0].TabVisible:=Flag;
    btnCancelar.Enabled := not(Flag);
    btnGravar.Enabled := not(Flag);
end;
{$ENDREGION}




end.
