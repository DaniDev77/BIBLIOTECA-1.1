  private
  SelectOriginal:string;
    procedure ControlarBotoes(btnNovo, btnAlterar, btnCancelar, btnGravar, btnApagar: TBitBtn; pgcPrincipal: TPageControl;
      Flag:Boolean);
    procedure ControlarIndiceTab(pgcPrincipal: TPageControl; Indice: Integer);
    procedure DesabilitarEditPK;
    procedure ExibirLabelIndice(Campo: string; aLabel: TLabel);
    function ExisteCampoObrigatorio: Boolean;
    procedure LimparEdits;
    function RetornarCampoTraduzido(Campo: string): string;

    { Private declarations }
  public
  IndiceAtual:string;
  EstadoDoCadastro:TEstadoCadastro;
  function Apagar:Boolean; virtual;
    function Gravar(EstadoDoCadastro: TEstadoCadastro):Boolean; virtual;
    { Public declarations }
  end;

var
  Heranca: THeranca;

implementation

{$R *.dfm}


{$REGION ' PROCEDIMENTO DE CONTROLE DE TELA'}


procedure THeranca.ControlarBotoes(btnNovo, btnAlterar, btnCancelar ,
 btnGravar, btnApagar:TBitBtn ;
  pgcPrincipal: TPageControl ; Flag:Boolean);
begin
    btnNovo.Enabled  :=Flag;
    btnApagar.Enabled   :=Flag;
    btnAlterar.Enabled  :=Flag;
    pgcPrincipal.Pages[0].TabVisible:=Flag;
    btnCancelar.Enabled := not(Flag);
    btnGravar.Enabled := not(Flag);
end;
{$ENDREGION}

{$REGION ' METOODOS VIRTUAIS'}
function THeranca.Apagar:Boolean;
begin
    ShowMessage('DELETADO');
    Result := True;
end;
  function THeranca.Gravar(EstadoDoCadastro: TEstadoCadastro):Boolean;
begin
     if (EstadoDoCadastro=ecInserir)then
     Showmessage('Inserir')
     else if (EstadoDoCadastro=ecAlterar) then
     ShowMessage('Alterado');
     Result := True;

end;



{$ENDREGION}

{$REGION ' FUNÇAO PARA RETORNAR CAMPO'}
   function THeranca.RetornarCampoTraduzido(Campo:string):string;
    var i :Integer;
   begin
    for I := 0 to FDQListagem.Fields.Count-1 do begin
      if LowerCase(FDQListagem.Fields[i].FieldName)=LowerCase(Campo) then begin
      Result :=FDQListagem.Fields[i].DisplayLabel;
       Break
      end;
    end;
   end;


procedure THeranca.ExibirLabelIndice(Campo:string; aLabel:TLabel);
   begin
     aLabel.Caption:=RetornarCampoTraduzido(Campo);
   end;
        //FUNÇÃO CAMPO OBRIGATORIO
  function THeranca.ExisteCampoObrigatorio:Boolean;
  var i:Integer;
   begin
   Result:=False;
   for I := 0 to ComponentCount -1 do begin
    if(Components[i] is TLabeledEdit) then begin
      if (TLabeledEdit(Components[i]).Tag =2)and
         (TLabeledEdit(Components[i]).Text=EmptyStr) then begin
         MessageDlg(TLabeledEdit(Components[i]).EditLabel.Caption +
                      'é um campo obrigatorio',mtInformation,[mbOK],0);
         TLabeledEdit(Components[i]).SetFocus;
         Result:=true;
         Break;
         end;

     end;
   end;

   end;

procedure THeranca.DesabilitarEditPK;
var i:Integer;
begin
  for I := 0 to ComponentCount -1 do begin
    if(Components[i] is TLabeledEdit) then begin
      if (TLabeledEdit(Components[i]).Tag =1) then begin
        TLabeledEdit(Components[i]).Enabled:=False;
        Break;
      end;
    end;
  end;
end;

procedure THeranca.LimparEdits;
var i:Integer;
begin
  for I := 0 to ComponentCount -1 do begin
    if(Components[i] is TLabeledEdit) then
        TLabeledEdit(Components[i]).Text:=EmptyStr
    else if (Components[i] is TEdit) then
    TEdit(Components[i]).Text:=''
     else if (Components[i] is TMaskEdit) then
    TMaskEdit(Components[i]).Text:=''
     else if (Components[i] is TMemo) then
      TMemo(Components[i]).Text:=''
      end;
    end;

{$ENDREGION}

{$REGION 'PESQUISAR'}
procedure THeranca.btnPesquisarClick(Sender: TObject);
var
  I: Integer;
  TipoCampo: TFieldType;
  NomeCampo: string;
  WhereOrAnd: string;
  CondicaoSQL: string;
  SQLSemOrder: string;
  OrderByClause: string;
  PosOrder: Integer;
  Texto: string;
begin
  Texto := Trim(mskPesquisar.Text);

  if FDQListagem.State in [dsEdit, dsInsert] then
    FDQListagem.Cancel;

  // Se vazio, restaura o SELECT original
  if Texto = '' then
  begin
    FDQListagem.Close;
    FDQListagem.SQL.Text := SelectOriginal;
    FDQListagem.Open;
    Exit;
  end;

  NomeCampo   := '';
  CondicaoSQL := '';

  // Remove ORDER BY para montar o WHERE
  PosOrder := Pos('ORDER BY', UpperCase(SelectOriginal));
  if PosOrder > 0 then
  begin
    SQLSemOrder   := Copy(SelectOriginal, 1, PosOrder - 1);
    OrderByClause := Copy(SelectOriginal, PosOrder, Length(SelectOriginal));
  end
  else
  begin
    SQLSemOrder   := SelectOriginal;
    OrderByClause := '';
  end;

  // WHERE ou AND dependendo se já existe WHERE no SQL
  if Pos('WHERE', UpperCase(SQLSemOrder)) > 0 then
    WhereOrAnd := ' AND '
  else
    WhereOrAnd := ' WHERE ';

  // Identifica o campo e tipo conforme IndiceAtual
  for I := 0 to FDQListagem.FieldCount - 1 do
  begin
    if FDQListagem.Fields[I].FieldName = IndiceAtual then
    begin
      TipoCampo := FDQListagem.Fields[I].DataType;

      if IndiceAtual = 'id' then
      begin
        NomeCampo := 'id';
        TipoCampo := ftInteger;
      end
      else if IndiceAtual = 'titulo' then
        NomeCampo := 'titulo'
      else if IndiceAtual = 'autor' then
        NomeCampo := 'autor'
      else if IndiceAtual = 'genero' then
        NomeCampo := 'genero'
      else if IndiceAtual = 'ano_de_publicacao' then
      begin
        NomeCampo := 'ano_de_publicacao';
        TipoCampo := ftInteger;
      end
      else if IndiceAtual = 'resumo' then
        NomeCampo := 'resumo'
      else
        NomeCampo := FDQListagem.Fields[I].FieldName;

      Break;
    end;
  end;

  if NomeCampo = '' then
  begin
    ShowMessage('Campo inválido para pesquisa!');
    Exit;
  end;

  // Monta condição conforme tipo do campo
  if TipoCampo in [ftInteger, ftSmallint, ftAutoInc] then
  begin
    if not TryStrToInt(Texto, I) then
    begin
      ShowMessage('Digite um número válido!');
      Exit;
    end;
    CondicaoSQL := WhereOrAnd + NomeCampo + ' = ' + IntToStr(I);
  end
  else if TipoCampo in [ftString, ftWideString, ftMemo, ftWideMemo] then
  begin
    CondicaoSQL :=
      WhereOrAnd +
      'UPPER(' + NomeCampo + ') LIKE ' +
      QuotedStr('%' + UpperCase(Texto) + '%');
  end;

  // Executa a pesquisa
  FDQListagem.Close;
  FDQListagem.SQL.Clear;
  FDQListagem.SQL.Text :=
    Trim(SQLSemOrder) + ' ' +
    Trim(CondicaoSQL) + ' ' +
    Trim(OrderByClause);
  FDQListagem.Open;

  mskPesquisar.Clear;
  mskPesquisar.SetFocus;
end;
procedure THeranca.mskPesquisarChange(Sender: TObject);
var
  Date: TDateTime;
begin
  if Trim(TMaskEdit(Sender).Text) = '' then
    Exit;

  if FDQListagem.FieldByName(IndiceAtual).DataType in
     [ftString, ftWideString, ftMemo, ftWideMemo] then
  begin
    FDQListagem.Locate(IndiceAtual, TMaskEdit(Sender).Text, [loPartialKey]);
  end
  else if FDQListagem.FieldByName(IndiceAtual).DataType in
          [ftInteger, ftSmallint, ftAutoInc] then
  begin
    try
      FDQListagem.Locate(IndiceAtual, TMaskEdit(Sender).Text, []);
    except
    end;
  end
  else if FDQListagem.FieldByName(IndiceAtual).DataType in
          [ftDate, ftDateTime, ftTimeStamp] then
  begin
    if TryStrToDate(TMaskEdit(Sender).Text, Date) then
      FDQListagem.Locate(IndiceAtual, Date, []);
  end
  else
    FDQListagem.Locate(IndiceAtual, TMaskEdit(Sender).Text, []);
end;
{$ENDREGION}

{$REGION ' INDICETAB'}{  }
procedure THeranca.ControlarIndiceTab( pgcPrincipal: TPageControl ; Indice:Integer);
 begin
   if (pgcPrincipal.Pages[Indice].TabVisible) then
     pgcPrincipal.TabIndex:=Indice;

 end;


{$ENDREGION}

{$REGION ' BOTAO NOVO'    }
procedure THeranca.btnNovoClick(Sender: TObject);
begin
ControlarBotoes(btnNovo, btnAlterar, btnCancelar ,
                    btnGravar, btnApagar,pgcPrincipal,false);
EstadoDoCadastro:=ecInserir;
end;


{$ENDREGION}

{$REGION ' BOTAO ALTERAR'}{ }
 procedure THeranca.btnAlterarClick(Sender: TObject);
begin
 ControlarBotoes(btnNovo, btnAlterar, btnCancelar ,
                    btnGravar, btnApagar,pgcPrincipal,false);
    EstadoDoCadastro:=ecAlterar;
end;


{$ENDREGION}

{$REGION ' BOTAO APAGAR'}{ }
procedure THeranca.btnApagarClick(Sender: TObject);
begin
 try
  if (Apagar) then begin
    ControlarBotoes(btnNovo, btnAlterar, btnCancelar ,
            btnGravar, btnApagar,pgcPrincipal,True);
    ControlarIndiceTab( pgcPrincipal,0);

   FDQListagem.Refresh;
    end
    else    begin
      MessageDlg('Erro ao Apagar',mtError,[mbOK],0);
    end;
  finally
     EstadoDoCadastro:=ecNenhum;
  end;
end;

{$ENDREGION}

{$REGION ' BOTAO CANCELAR'}
 procedure THeranca.btnCancelarClick(Sender: TObject);
begin
 ControlarBotoes(btnNovo, btnAlterar, btnCancelar ,
                btnGravar, btnApagar,pgcPrincipal,true);
 ControlarIndiceTab( pgcPrincipal,0);
  EstadoDoCadastro:=ecNenhum;
  LimparEdits;
end;

procedure THeranca.btnFecharClick(Sender: TObject);
begin
Close;
end;

{$ENDREGION}

{$REGION ' BOTAO GRAVAR'}
procedure THeranca.btnGravarClick(Sender: TObject);
begin
try
  if  Gravar(EstadoDoCadastro) then begin
         ControlarBotoes(btnNovo, btnAlterar, btnCancelar ,
                 btnGravar, btnApagar,pgcPrincipal,true);
  ControlarIndiceTab( pgcPrincipal,0);
   EstadoDoCadastro:=ecNenhum;
   FDQListagem.Refresh;
  end
  else begin
    MessageDlg('Erro na Gravação',mtError,[mbOK],0);
  end;
  finally
  end;
end;
 {$ENDREGION}

 {$REGION 'FORMS'}
procedure THeranca.FormClose(Sender: TObject; var Action: TCloseAction);
begin
 FDQListagem.Close;
end;

procedure THeranca.FormCreate(Sender: TObject);
var
  i: Integer;
begin
      dtslistagem.DataSet:=FDQListagem;
      grdListagem.DataSource:=dtslistagem;
      grdListagem.Options:=[dgTitles,dgIndicator,dgColumnResize,
      dgColLines,dgRowLines,dgTabs,
      dgRowSelect,dgAlwaysShowSelection,dgCancelOnExit,
      dgTitleClick,dgTitleHotTrack]

end;
 procedure THeranca.FormShow(Sender: TObject);
begin
   if (FDQListagem.SQL.Text<>EmptyStr) then begin
     FDQListagem.IndexFieldNames:=IndiceAtual;
     ExibirLabelIndice(IndiceAtual,lblIndice);
    SelectOriginal:=FDQListagem.SQL.Text;
     FDQListagem.Open;
     end;
     ControlarIndiceTab( pgcPrincipal,0);
     ControlarBotoes(btnNovo, btnAlterar, btnCancelar ,
                    btnGravar, btnApagar,pgcPrincipal,True);
end;
               {$ENDREGION}

{$REGION ' AREA DO FILDNAME'}
procedure THeranca.grdListagemTitleClick(Column: TColumn);
begin
    IndiceAtual:= Column.FieldName;
    FDQListagem.IndexFieldNames:=IndiceAtual;
    ExibirLabelIndice(IndiceAtual,lblIndice);
end;

   {$ENDREGION}




               end.
