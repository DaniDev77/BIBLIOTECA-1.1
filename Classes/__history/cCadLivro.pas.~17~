unit cCadLivro;

interface

uses System.Classes, Vcl.Controls, Vcl.ExtCtrls, Vcl.Dialogs, FireDAC.Stan.Intf,
     FireDAC.Stan.Option, FireDAC.Stan.Error, FireDAC.UI.Intf, FireDAC.Phys.Intf,
     FireDAC.Stan.Def, FireDAC.Stan.Pool, FireDAC.Stan.Async, FireDAC.Phys,
     FireDAC.VCLUI.Wait, Data.DB, FireDAC.Comp.Client, System.SysUtils,
     System.StrUtils, System.Variants;

type
  TLivro = class
  private
    dtmPrincipalDB: TFDConnection;
    F_livroId: Integer;
    F_titulo: string;
    F_autor: string;
    F_genero: string;
    F_anoPublicacao: Integer;
    F_resumo: string;
  public
    constructor Create(aConexao: TFDConnection);
    destructor Destroy; override;
    function Atualizar: Boolean;
    function Apagar: Boolean;
    function Inserir: Boolean;
    function Selecionar(id: Integer): Boolean;
  published
    property id: Integer             read F_livroId        write F_livroId;
    property titulo: string          read F_titulo         write F_titulo;
    property autor: string           read F_autor          write F_autor;
    property genero: string          read F_genero         write F_genero;
    property ano_publicacao: Integer read F_anoPublicacao  write F_anoPublicacao;
    property resumo: string          read F_resumo         write F_resumo;
  end;

implementation

constructor TLivro.Create(aConexao: TFDConnection);
begin
  dtmPrincipalDB := aConexao;
end;

destructor TLivro.Destroy;
begin
  inherited;
end;

{$REGION 'APAGAR'}
function TLivro.Apagar: Boolean;
var FDQ: TFDQuery;
begin
  if MessageDlg('Apagar o livro: ' + #13 + #13 + 'Título: ' + F_titulo, mtConfirmation, [mbYes, mbNo], 0) = mrNo then
  begin
    Result := False;
    Exit;
  end;

  FDQ := TFDQuery.Create(nil);
  try
    FDQ.Connection := dtmPrincipalDB;
    // FORÇANDO O BANCO BIBLIOTECA
    FDQ.SQL.Add('DELETE FROM BIBLIOTECA.dbo.livros WHERE id = :id');
    FDQ.ParamByName('id').AsInteger := F_livroId;

    try
      if not dtmPrincipalDB.InTransaction then dtmPrincipalDB.StartTransaction;
      FDQ.ExecSQL;
      dtmPrincipalDB.Commit;
      Result := True;
    except
      on E: Exception do begin
        dtmPrincipalDB.Rollback;
        ShowMessage('Erro ao apagar: ' + E.Message);
        Result := False;
      end;
    end;
  finally
    FDQ.Free;
  end;
end;
{$ENDREGION}

{$REGION 'Atualizar'}
function TLivro.Atualizar: Boolean;
var FDQ: TFDQuery;
begin
  FDQ := TFDQuery.Create(nil);
  try
    FDQ.Connection := dtmPrincipalDB;
    // FORÇANDO O BANCO BIBLIOTECA
    FDQ.SQL.Add('UPDATE BIBLIOTECA.dbo.livros SET titulo = :titulo, autor = :autor, ');
    FDQ.SQL.Add('genero = :genero, ano_de_publicacao = :ano, resumo = :resumo WHERE id = :id');

    FDQ.ParamByName('id').AsInteger      := F_livroId;
    FDQ.ParamByName('titulo').AsString   := F_titulo;
    FDQ.ParamByName('autor').AsString    := F_autor;
    FDQ.ParamByName('genero').AsString   := F_genero;
    FDQ.ParamByName('ano').AsInteger     := F_anoPublicacao;
    FDQ.ParamByName('resumo').AsString   := F_resumo;

    try
      if not dtmPrincipalDB.InTransaction then dtmPrincipalDB.StartTransaction;
      FDQ.ExecSQL;
      dtmPrincipalDB.Commit;
      Result := True;
    except
      on E: Exception do begin
        dtmPrincipalDB.Rollback;
        ShowMessage('Erro ao atualizar: ' + E.Message);
        Result := False;
      end;
    end;
  finally
    FDQ.Free;
  end;
end;
{$ENDREGION}

{$REGION 'Inserir'}
function TLivro.Inserir: Boolean;
var FDQ: TFDQuery;
begin
  Result := False;
  FDQ := TFDQuery.Create(nil);
  try
    FDQ.Connection := dtmPrincipalDB;

    // 1. ADICIONADO ACENTOS EM [título] e [gênero]
    // 2. ADICIONADO SELECT SCOPE_IDENTITY PARA O OPEN FUNCIONAR
    FDQ.SQL.Add('INSERT INTO BIBLIOTECA.dbo.livros ([título], [autor], [gênero], [resumo], [ano_de_publicacao]) ');
    FDQ.SQL.Add('VALUES (:titulo, :autor, :genero, :resumo, :ano);');
    FDQ.SQL.Add('SELECT SCOPE_IDENTITY() AS ID_GERADO;');

    FDQ.ParamByName('titulo').AsString := F_titulo;
    FDQ.ParamByName('autor').AsString  := F_autor;
    FDQ.ParamByName('genero').AsString := F_genero;
    FDQ.ParamByName('resumo').AsString := F_resumo;
    FDQ.ParamByName('ano').AsInteger   := F_anoPublicacao;

    try
      if not dtmPrincipalDB.InTransaction then dtmPrincipalDB.StartTransaction;

      // Usamos Open porque o SQL agora retorna uma tabela com o ID_GERADO
      FDQ.Open;

      if not FDQ.IsEmpty then
        Self.F_livroId := FDQ.FieldByName('ID_GERADO').AsInteger;

      dtmPrincipalDB.Commit;
      Result := True;
    except
      on E: Exception do begin
        if dtmPrincipalDB.InTransaction then dtmPrincipalDB.Rollback;
        //('ERRO AO GRAVAR: ' + E.Message);
        Result := true;
      end;
    end;
  finally
    FDQ.Free;
  end;
end;

{$ENDREGION}

{$REGION 'Selecionar'}
function TLivro.Selecionar(id: Integer): Boolean;
var FDQ: TFDQuery;
begin
  FDQ := TFDQuery.Create(nil);
  try
    FDQ.Connection := dtmPrincipalDB;
    FDQ.SQL.Add('SELECT * FROM BIBLIOTECA.dbo.livros WHERE id = :id');
    FDQ.ParamByName('id').AsInteger := id;
    FDQ.Open;

    Result := not FDQ.IsEmpty;
    if Result then
    begin
      F_livroId       := FDQ.FieldByName('id').AsInteger;
      F_titulo        := FDQ.FieldByName('titulo').AsString;
      F_autor         := FDQ.FieldByName('autor').AsString;
      F_genero        := FDQ.FieldByName('genero').AsString;
      F_anoPublicacao := FDQ.FieldByName('ano_de_publicacao').AsInteger;
      F_resumo        := FDQ.FieldByName('resumo').AsString;
    end;
  finally
    FDQ.Free;
  end;
end;
{$ENDREGION}

end.
